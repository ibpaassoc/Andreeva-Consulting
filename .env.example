# URL for one real 30-minute Calendly event, e.g. https://calendly.com/account/consultation
NEXT_PUBLIC_CALENDLY_URL=
# Question form: configure a verified sender and destination; never expose the API key to the client.
RESEND_API_KEY=
QUESTION_FROM_EMAIL=
QUESTION_TO_EMAIL=
# Shared rate-limit store; production deploys must provide both Upstash values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional server-verified Turnstile challenge; set both values together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Enable the question form only after approved privacy copy is published.
PRIVACY_COPY_APPROVED=false
# Optional footer contacts; publish only owner-confirmed addresses and links.
CONTACT_EMAIL=
INSTAGRAM_URL=
TELEGRAM_URL=
WHATSAPP_URL=
